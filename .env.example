# ============================================================
# Kenangin — environment contract
# Copy this file to .env.local. Do not commit real secrets.
# Patch 0 validates the shape only; integrations arrive later.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client (safe to expose to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (SERVER ONLY)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Backblaze B2 (SERVER ONLY)
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_INGEST_BUCKET=
B2_PUBLIC_BUCKET=

# Gemini (SERVER ONLY)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# Worker (SERVER ONLY)
WORKER_DISPATCH_TOKEN=
WORKER_REPOSITORY=
WORKER_WORKFLOW=

# Auth/session
SESSION_COOKIE_NAME=kenangin_session
