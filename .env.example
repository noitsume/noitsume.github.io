# ============================================================
# Kenangin — Patch 2 environment contract
# Copy this file to .env.local. NEVER commit .env.local.
# Empty optional values are allowed while you are setting things up.
# ============================================================

# ------------------------------------------------------------
# App / Vercel
# ------------------------------------------------------------
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Firebase Web SDK (safe to expose to browser)
# Firebase Console > Project settings > Your apps > Web app
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# Firebase Admin SDK (SERVER ONLY)
# Firebase Console > Project settings > Service accounts
# Copy values from the downloaded service-account JSON.
# Keep FIREBASE_PRIVATE_KEY in one line with literal \n characters.
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------
# Backblaze B2 S3-Compatible API (SERVER ONLY)
# Both buckets stay PRIVATE. Browser access uses short-lived presigned URLs.
# Example endpoint: https://s3.us-east-005.backblazeb2.com
# Region is the middle part: us-east-005
# ------------------------------------------------------------
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=

# One-time local setup key for `npm run b2:cors`.
# This key must NOT be bucket-restricted because PutBucketCors needs writeBuckets.
# Delete/revoke it after CORS succeeds. Never add these two values to Vercel.
B2_SETUP_KEY_ID=
B2_SETUP_APPLICATION_KEY=

# Single PRIVATE bucket for all Kenangin files.
# Prefixes keep data organized: rooms/, theme-assets/, aura-assets/, songs/.
B2_BUCKET=

# Optional extra browser origins for B2 CORS, comma-separated.
# Leave blank at first. Add exact Preview URLs only when needed.
B2_CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------
# Gemini API (SERVER ONLY)
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TIMEOUT_MS=8000

# ------------------------------------------------------------
# Auth/session — consumed in Patch 3
# ------------------------------------------------------------
SESSION_COOKIE_NAME=kenangin_session
