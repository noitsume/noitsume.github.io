rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsRoom(roomId) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      // Dashboard/client boleh membaca room miliknya.
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Semua mutation room melewati Next.js API + Firebase Admin.
      // Admin SDK bypasses Firestore Security Rules, lalu API route yang
      // bertanggung jawab melakukan auth, authorization, dan Zod validation.
      allow create, update, delete: if false;

      match /media/{mediaId} {
        allow read: if ownsRoom(roomId);
        allow write: if false;
      }

      match /submissions/{submissionId} {
        allow read: if ownsRoom(roomId);
        allow write: if false;
      }

      match /analytics/{eventId} {
        allow read: if ownsRoom(roomId);
        allow write: if false;
      }
    }

    // Receiver publik akan disajikan lewat Next.js API/SSR pada Patch 7-8.
    match /receivers/{receiverId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
