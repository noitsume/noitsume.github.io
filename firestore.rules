rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsRoom(roomId) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      // Profile dibuat/disinkronkan server-side saat session login.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /rooms/{roomId} {
      // Direct client read tetap owner-only. Semua mutation lewat Next.js API.
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;

      match /media/{mediaId} {
        allow read: if ownsRoom(roomId);
        allow write: if false;
      }

      match /submissions/{submissionId} {
        allow read: if ownsRoom(roomId);
        allow write: if false;
      }

      match /analytics/{eventId} {
        allow read: if ownsRoom(roomId);
        allow write: if false;
      }
    }

    match /receivers/{receiverId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
